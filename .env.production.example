# Copy to .env.production on the VM, then replace all placeholders privately.
# This is a template, not a deployable set of credentials. Never commit the real file.
SOCIALSCOPE_RELEASE=pilot-0.1.0
SOCIALSCOPE_IMAGE_PREFIX=socialscope
SOCIALSCOPE_PUBLIC_ORIGIN=https://YOUR_VM_PUBLIC_IP
SOCIALSCOPE_WEB_PORT=3002

# Verify actual names on the VM; these are the current project's expected names.
SOCIALSCOPE_POSTGRES_VOLUME=socialscope_postgres_data
SOCIALSCOPE_REDIS_VOLUME=socialscope_redis_data
SOCIALSCOPE_EXPORT_VOLUME=socialscope_export_data

# For an existing database, preserve its actual user/database/password.
# POSTGRES_PASSWORD does NOT change a password inside an initialized database.
POSTGRES_USER=socialscope
POSTGRES_DB=socialscope
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD
# Match the password above, URL-encoding special characters in this URL only.
DATABASE_URL=postgresql+asyncpg://socialscope:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/socialscope

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_PRODUCTION_SECRET
LOCAL_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
LOCAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_12_PLUS_CHARACTER_PASSWORD

# Provider keys remain server-side. Copy real keys privately to .env.production,
# never into this example. Missing keys leave the corresponding provider unavailable.
SOCIALVAULT_API_KEY=
XPOZ_API_KEY=
# Optional: blank uses local deterministic query suggestions.
OPENAI_API_KEY=

# The values below match backend defaults, not measured provider/account guarantees.
# Preserve intentional, tested overrides from your private local configuration.
# Timing values are seconds unless the name explicitly says otherwise.

# Xpoz request rate, concurrency, timeouts, and pagination.
XPOZ_REQUESTS_PER_PERIOD=28
XPOZ_RATE_PERIOD_SECONDS=60
XPOZ_MAX_CONCURRENCY=2
XPOZ_OPERATION_TIMEOUT_SECONDS=300
XPOZ_NO_PROGRESS_TIMEOUT_SECONDS=300
XPOZ_MAX_PAGES=100
XPOZ_RETRY_TIME_BUDGET_SECONDS=60
XPOZ_MAX_REPEATED_502=2

# SociaVault rate, concurrency, and request/pagination safeguards.
SOCIALVAULT_MAX_CONCURRENCY=5
SOCIALVAULT_REQUESTS_PER_PERIOD=8
SOCIALVAULT_RATE_PERIOD_SECONDS=1
SOCIALVAULT_REQUEST_TIMEOUT_SECONDS=30
SOCIALVAULT_NO_PROGRESS_TIMEOUT_SECONDS=120
SOCIALVAULT_MAX_PAGES=100
SOCIALVAULT_RETRY_TIME_BUDGET_SECONDS=60
SOCIALVAULT_MAX_REPEATED_502=3
SOCIALVAULT_PAGINATION_404_RETRIES=1
SOCIALVAULT_EARLY_RESTART_MAX_PAGES=5
SOCIALVAULT_EARLY_RESTART_MAX_TARGET_RATIO=0.3

# Collection cancellation and abandoned-job recovery.
COLLECTION_CANCELLATION_POLL_SECONDS=1
COLLECTION_ABANDONED_JOB_STALE_SECONDS=900
COLLECTION_ABANDONED_RECONCILE_INTERVAL_SECONDS=60
COLLECTION_ABANDONED_INSPECT_TIMEOUT_SECONDS=1
COLLECTION_ABANDONED_RECONCILE_BATCH_SIZE=100

# Temporary provider HTTP 429/5xx retry policy.
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_SECONDS=1
PROVIDER_RETRY_MAX_SECONDS=30

# Rate limiters are process-local. Keep one collection worker process until
# shared account-level limits and higher concurrency are separately validated.
COLLECTION_WORKER_CONCURRENCY=1

# Query validation safeguards, not official provider guarantees.
QUERY_SAFE_DEFAULT_MAX_LENGTH=200
XPOZ_QUERY_MAX_LENGTH=200
SOCIALVAULT_QUERY_MAX_LENGTH=200
QUERY_LENGTH_WARNING_RATIO=0.8

# Application console verbosity and browser token lifetime (minutes).
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Keep the signing algorithm unchanged unless authentication is deliberately migrated.
ALGORITHM=HS256

# Compose sets these for every Python service. Do not duplicate/edit them here:
# REDIS_URL -> redis://redis:6379/0
# CORS_ORIGINS -> SOCIALSCOPE_PUBLIC_ORIGIN above (browser origin, no trailing slash)
# BUILD_ID -> SOCIALSCOPE_RELEASE above
# Local-only API/PostgreSQL/Redis host-port variables are not used in production.

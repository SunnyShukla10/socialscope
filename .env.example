# Database — PostgreSQL with asyncpg driver
# Host ports are intentionally different from SocialPulse's defaults so both stacks
# can run at the same time. Web/API container ports also use 3001/8001.
# Overriding these variables changes host ports only; use the published URLs.
SOCIALSCOPE_WEB_PORT=3002
SOCIALSCOPE_API_PORT=8002
SOCIALSCOPE_POSTGRES_PORT=5434
SOCIALSCOPE_REDIS_PORT=6381

DATABASE_URL=postgresql+asyncpg://socialscope:socialscope@postgres:5432/socialscope

# Redis — used for Celery broker and result backend
REDIS_URL=redis://redis:6379/0

# JWT signing secret — CHANGE this in production to a long random string
SECRET_KEY=change-me-in-production

# Xpoz API key — used by the active Instagram route. The retained Twitter
# implementation is inactive unless routing is changed back to Xpoz.
XPOZ_API_KEY=

# Xpoz controls (currently used by Instagram)
XPOZ_REQUESTS_PER_PERIOD=28
XPOZ_RATE_PERIOD_SECONDS=60
XPOZ_MAX_CONCURRENCY=2
XPOZ_OPERATION_TIMEOUT_SECONDS=300
XPOZ_NO_PROGRESS_TIMEOUT_SECONDS=300
XPOZ_MAX_PAGES=100
XPOZ_RETRY_TIME_BUDGET_SECONDS=60
XPOZ_MAX_REPEATED_502=2

# SociaVault has independent request concurrency
SOCIALVAULT_MAX_CONCURRENCY=5
SOCIALVAULT_REQUEST_TIMEOUT_SECONDS=30
SOCIALVAULT_NO_PROGRESS_TIMEOUT_SECONDS=120
SOCIALVAULT_MAX_PAGES=100
SOCIALVAULT_RETRY_TIME_BUDGET_SECONDS=60
SOCIALVAULT_MAX_REPEATED_502=3
COLLECTION_CANCELLATION_POLL_SECONDS=1

# A periodic Celery beat task recovers jobs abandoned by worker or VM failure.
# Keep the stale threshold longer than the longest healthy provider operation.
COLLECTION_ABANDONED_JOB_STALE_SECONDS=900
COLLECTION_ABANDONED_RECONCILE_INTERVAL_SECONDS=60
COLLECTION_ABANDONED_INSPECT_TIMEOUT_SECONDS=1
COLLECTION_ABANDONED_RECONCILE_BATCH_SIZE=100

# Temporary HTTP 429/5xx retry policy
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_SECONDS=1
PROVIDER_RETRY_MAX_SECONDS=30

# The provider limiters are process-local. Keep this at 1 unless a distributed
# limiter is introduced; see RUNBOOK.md before horizontally scaling workers.
COLLECTION_WORKER_CONCURRENCY=1

# Conservative query safeguards. These are configurable safe defaults, not
# official provider guarantees.
QUERY_SAFE_DEFAULT_MAX_LENGTH=200
XPOZ_QUERY_MAX_LENGTH=200
SOCIALVAULT_QUERY_MAX_LENGTH=200
QUERY_LENGTH_WARNING_RATIO=0.8

# SociaVault API key — required for active Twitter/X, Reddit, TikTok, YouTube,
# and Facebook collection. Leave empty to return no connected-provider results.
SOCIALVAULT_API_KEY=

# OpenAI API key — leave empty to use local deterministic query suggestions
OPENAI_API_KEY=

# CORS allowed origins — comma-separated list
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supplied privately by the study administrator; shared account usage across installs is not globally capped.
BUILD_ID=pilot-local
LOCAL_ADMIN_EMAIL=admin@socialscope.local
LOCAL_ADMIN_PASSWORD=password123
